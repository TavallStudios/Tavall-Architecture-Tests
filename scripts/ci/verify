#!/usr/bin/env bash
set -euo pipefail

export TAVALL_PRIVATE_MAVEN_REPOSITORY="${TAVALL_PRIVATE_MAVEN_REPOSITORY:-/srv/dev-storage/deps/private}"

profile="${1:-all}"

if [[ -x ./gradlew && -f ./gradle/wrapper/gradle-wrapper.jar ]]; then
  gradle_cmd=(./gradlew)
elif command -v gradle >/dev/null 2>&1; then
  gradle_cmd=(gradle)
else
  echo "No Gradle executor is available. Expected a complete ./gradlew wrapper or gradle on PATH." >&2
  exit 69
fi

printf 'Repository: %s\n' "$(git config --get remote.origin.url 2>/dev/null || printf 'unknown')"
printf 'Head: %s\n' "$(git rev-parse HEAD)"
printf 'Profile: %s\n' "${profile}"

case "${profile}" in
  build)
    "${gradle_cmd[@]}" --no-daemon --stacktrace \
      :modules:web:compileJava \
      :gradle-plugin:compileJava
    ;;
  integration|architecture|architecture-combined|default)
    "${gradle_cmd[@]}" --no-daemon --stacktrace \
      :modules:web:check \
      :gradle-plugin:test
    ;;
  all)
    "${gradle_cmd[@]}" --version
    "${gradle_cmd[@]}" clean check --no-daemon --stacktrace
    "${gradle_cmd[@]}" --no-daemon --stacktrace \
      publishAllPublicationsToTavallPrivateRepository
    ;;
  *)
    echo "Unsupported CI profile: ${profile}" >&2
    exit 64
    ;;
esac
